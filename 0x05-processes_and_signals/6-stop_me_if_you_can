#!/usr/bin/env bash
# A Bash script that stops the 4-to_infinity_and_beyond process without using kill or killall

# Loop over all PIDs of 4-to_infinity_and_beyond
for PID in $(pgrep -f 4-to_infinity_and_beyond); do
    # Skip the current script's PID
    if [ "$PID" != "$$" ]; then
        # Use /proc interface to stop the process harmlessly
        echo 15 > /proc/"$PID"/oom_score_adj
    fi
done

