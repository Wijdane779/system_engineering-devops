#!/usr/bin/env bash
# A Bash script that stops the 4-to_infinity_and_beyond process without using kill or killall

# Use pgrep but exclude the current script PID
for PID in $(pgrep -x 4-to_infinity_and_beyond); do
    # Just to be safe, skip current script's PID
    if [ "$PID" -ne "$$" ]; then
        # harmless stop via /proc interface
        echo 15 > /proc/"$PID"/oom_score_adj
    fi
done

